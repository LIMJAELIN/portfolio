---
import '../styles/global.css';

const {
  title = '임재린 | Java / Spring Backend Developer',
  description = 'Java/Spring 기반 B2B ERP 실무와 개인 프로젝트의 문제 해결 과정을 정리한 백엔드 개발자 포트폴리오입니다.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const cases = `${base}/#cases`;
const experience = `${base}/#experience`;
const study = `${base}/#study`;
const about = `${base}/#about`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={home}>임재린</a>

        <nav class="desktop-nav" aria-label="주요 메뉴">
          <a href={cases}>Cases</a>
          <a href={experience}>Experience</a>
          <a href={study}>Study</a>
          <a href={about}>About</a>
        </nav>

        <div class="header-actions">
          <a class="header-link" href="https://github.com/LIMJAELIN" target="_blank" rel="noreferrer">GitHub ↗</a>
          <details class="mobile-menu">
            <summary aria-label="메뉴 열기">
              <span></span><span></span><span></span>
            </summary>
            <nav aria-label="모바일 메뉴">
              <a href={cases}>Cases</a>
              <a href={experience}>Experience</a>
              <a href={study}>Study</a>
              <a href={about}>About</a>
              <a href="https://github.com/LIMJAELIN" target="_blank" rel="noreferrer">GitHub ↗</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>임재린</strong>
          <p>Java / Spring Backend Developer</p>
        </div>
        <div class="footer-links">
          <a href="mailto:imjaelin@gmail.com">Email</a>
          <a href="https://github.com/LIMJAELIN" target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
