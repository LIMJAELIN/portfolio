---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const skillGroups = [
  {
    title: '백엔드',
    items: ['Java 8', 'Spring Boot', 'Spring MVC', 'Spring Transaction', 'MyBatis', 'Spring Scheduler'],
  },
  {
    title: '데이터베이스·연동',
    items: ['Oracle', 'PostgreSQL', 'SQL', 'REST API', 'HikariCP'],
  },
  {
    title: '클라우드·배포',
    items: ['Docker', 'Docker Compose', 'AWS ECS/Fargate', 'ECR', 'RDS', 'SSM', 'CloudWatch', 'GitHub Actions'],
  },
  {
    title: '학습 및 개인 프로젝트',
    items: ['Java 21 / 25', 'Spring Boot 4', 'Spring Data JPA', 'Hibernate', 'JDBC', 'PostgreSQL'],
  },
];

const productionCases = [
  {
    index: '01',
    type: 'Performance',
    title: '사원등록 초기 로딩 성능 개선',
    summary: '10개가 넘는 하위 탭을 가진 화면에서 최초 진입에 필요하지 않은 초기화와 조회를 실제 사용 시점으로 지연해 초기 경로를 단순화했습니다.',
    evidence: ['지연 로딩', '화면–API 호출 흐름 분석', 'Production'],
    href: `${base}/cases/employee-loading-performance/`,
  },
  {
    index: '02',
    type: 'Business Logic',
    title: '복잡한 근무정책을 일자별 근무계획으로 변환',
    summary: '근무유형별 시간·교대 규칙과 여러 휴게시간 입력 경로를 하나의 생성 흐름에서 처리하고 자정 경계·비근무일 예외조건을 보완했습니다.',
    evidence: ['5개 근무유형', '3개 휴게시간 소스', '날짜 경계 / 정합성'],
    href: `${base}/cases/work-schedule-policy/`,
  },
  {
    index: '03',
    type: 'Transaction / Batch',
    title: '재집계 배치의 대상 선별과 부분 실패 격리',
    summary: '원천 데이터 변경 여부로 재집계 대상을 선별하고 처리 단위를 REQUIRES_NEW로 분리해 한 건의 오류가 전체 배치로 번지지 않도록 구성했습니다.',
    evidence: ['REQUIRES_NEW', '부분 실패 격리', '재처리 / 실패 집계'],
    href: `${base}/cases/batch-partial-failure/`,
  },
  {
    index: '04',
    type: 'Spring / Database',
    title: 'Multi DataSource Routing',
    summary: '회사 코드를 routing key로 사용해 3개 DB 환경 중 대상을 동적으로 선택하고 transaction과 실제 Connection 획득 시점의 관계까지 고려했습니다.',
    evidence: ['3 DataSources', 'LazyConnectionDataSourceProxy', 'HikariCP'],
    href: `${base}/cases/multi-datasource-routing/`,
  },
  {
    index: '05',
    type: 'Business Workflow',
    stage: '회사 업무',
    title: '월근태 마감 후 변경 감지와 선택 재집계',
    summary: '마감된 근태에서 4종 원천 변경을 감지·확인하고 데이터 잠금과 선택 날짜 재집계 흐름을 Spring/MyBatis로 구현했습니다.',
    evidence: ['4종 원천 변경 감지', 'FOR UPDATE', '마감 상태 / 정합성'],
    href: `${base}/cases/month-close-rebuild/`,
  },
  {
    index: '06',
    type: 'System Integration',
    stage: '회사 업무',
    title: 'Windows 근태 수집 앱부터 ERP까지 연동',
    summary: '외부 장비 DB 조회, 로컬 SQLite 동기화, 시간대 오류 수정과 별도 Spring 서버·ERP 데이터 계약 변경에 기여했습니다.',
    evidence: ['Electron / Node.js', 'PostgreSQL / SQLite', '시간대 / API 계약'],
    href: `${base}/cases/attendance-integration/`,
  },
];

const moreExperience = [
  {
    title: 'ERP Dashboard · Vue 3 / TypeScript',
    description: '근태 일정 위젯을 구현하고 화면의 조회 조건부터 Spring Service 분기와 MyBatis 조회 SQL까지 한 흐름으로 수정했습니다.',
  },
  {
    title: '근태 알림 상태 관리',
    description: '미출근·미퇴근 알림의 대기·발송중·성공·실패 상태를 분리하고 실패 대상 재처리와 중복 생성을 방지했습니다.',
  },
  {
    title: 'eSign Integration & UI State',
    description: '계약 생성·외부 식별자·상태·PDF 조회를 연계하고 재조회 후 선택 행이 어긋나는 문제를 업무 식별 키 기반 복원으로 수정했습니다.',
  },
  {
    title: 'StockDataController',
    description: '금융 API 기반 실시간 데이터 수집, 호출 제한·시장시간 처리와 비동기 처리 및 성능 개선 영역을 담당했습니다.',
  },
];
---

<SiteLayout>
  <div class="resume-home">
    <section class="resume-intro resume-sheet" id="top">
      <div class="intro-grid"><div>
      <p class="resume-kicker">BACKEND DEVELOPER · 비즈비 ERP 개발 2팀</p>
      <h1>임재린</h1>
      <p class="intro-meta">2024.02 — 현재 · Java / Spring · Oracle</p>
      <p class="intro-lead">업무의 규칙과 데이터 흐름을<br />함께 살피며 개발합니다.</p>
      <p class="intro-body">인사·근태·급여 ERP에서 근무정책과 재집계, 외부 시스템 연동을 개발합니다. 개인 프로젝트에서는 읽기 전용 관제 앱과 AWS 배포·장애 대응을 경험했습니다.</p>
      <div class="intro-links">
        <a href="mailto:imjaelin@gmail.com">imjaelin@gmail.com</a>
        <a href="https://github.com/LIMJAELIN" target="_blank" rel="noreferrer">github.com/LIMJAELIN ↗</a>
      </div>
      </div><img class="intro-photo" src={`${base}/profile.png`} alt="임재린 프로필 사진" width="900" height="1200" /></div>
    </section>

    <div class="resume-document resume-sheet">
      <section class="resume-section featured-work" aria-labelledby="featured-title">
        <p class="section-label">SELECTED WORK</p>
        <h2 id="featured-title">먼저 볼 수 있는 업무 경험</h2>
        <p class="featured-intro">현장의 요구사항을 업무 규칙과 데이터 처리로 연결한 사례입니다.</p>
        <div class="featured-grid">
          <a href={`${base}/cases/work-schedule-policy/`}><span>01 · 근무정책</span><strong>자동 생성과 담당자의 수정이 함께 유지되도록</strong><p>근무유형별 계획을 만들면서 담당자가 조정한 내용을 배치에서 보호했습니다.</p><b>근무계획 사례 보기 ↗</b></a>
          <a href={`${base}/cases/month-close-rebuild/`}><span>02 · 마감과 재집계</span><strong>마감 후 바뀐 근태를 필요한 날짜만 다시 집계</strong><p>원천 데이터 변경을 확인하고 담당자가 선택한 날짜의 재집계를 연결했습니다.</p><b>월근태 사례 보기 ↗</b></a>
          <a href={`${base}/cases/attendance-integration/`}><span>03 · 외부 연동</span><strong>장비 출입기록을 수집해 ERP에서 활용</strong><p>Windows 수집 앱의 조회·동기화·전송과 ERP 연동을 다뤘습니다.</p><b>근태 연동 사례 보기 ↗</b></a>
        </div>
      </section>
      <section class="resume-section" id="skills">
        <div class="resume-section-head">
          <p class="section-label">기술 스택</p>
        </div>
        <div class="skill-matrix">
          {skillGroups.map((group) => (
            <div class="skill-row">
              <div class="skill-title">
                <h2>{group.title}</h2>
              </div>
              <p class="skill-items">{group.items.join(' · ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="resume-section" id="experience">
        <div class="resume-section-head">
          <p class="section-label">EXPERIENCE</p>
          <span>2024.02 — Present</span>
        </div>

        <article class="career-block">
          <div class="career-meta">
            <span>비즈비</span>
            <span>Production</span>
          </div>
          <h2>ERP Developer · Java / Spring Backend</h2>
          <ul class="career-highlights">
            <li>인사·근태·급여 ERP에서 AngularJS 화면부터 Spring API·DB 처리까지 기능 단위 End-to-End 개발</li>
            <li>근무정책·교대·휴일·익일 처리와 계획 변경 후 재계산 등 날짜·상태 기반 업무 규칙 구현</li>
            <li>월근태 마감 후 4종 원천 변경 감지·확인, 데이터 잠금과 선택 날짜 재집계 흐름 구현</li>
            <li>Spring Transaction / Scheduler 기반 배치, 부분 실패 격리와 재처리 흐름 개발</li>
            <li>외부 전자계약 REST API 6종 연동 및 회사별 Multi DataSource 환경 구성</li>
            <li>Electron 기반 Windows 근태 수집 앱의 외부 DB 연동·SQLite 동기화·시간대 오류 및 고객 환경 연결 문제 대응</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Java 8 · Spring Boot · Spring MVC · Spring Transaction · MyBatis · Oracle · HikariCP · Spring Scheduler · REST API</p>
        </article>
      </section>

      <section class="resume-section" id="projects">
        <div class="resume-section-head">
          <p class="section-label">SELECTED PRODUCTION WORK</p>
          <span>상세 페이지에서 문제 → 판단 → 구현 → 결과</span>
        </div>

        <div class="project-list">
          {productionCases.map((item) => (
            <a class="project-row" href={item.href}>
              <div class="project-number">{item.index}</div>
              <div class="project-content">
                <div class="project-eyebrow">{item.type} · {item.stage || 'Production'}</div>
                <h2>{item.title}</h2>
                <p>{item.summary}</p>
                <div class="project-tags">{item.evidence.map((tag) => <span>{tag}</span>)}</div>
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="resume-section" id="personal-projects">
        <div class="resume-section-head">
          <p class="section-label">PERSONAL PROJECT</p>
          <span>개인 연구와 클라우드 운영 경험</span>
        </div>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">2026 — Present · Personal / Research</p>
              <h2>StratDock</h2>
              <p class="project-subtitle">전략 신호 검증·오프라인 GHOST 가상 원장·상태 복원</p>
            </div>
          </div>
          <ul class="career-highlights compact">
            <li>동결된 신호 계약을 기반으로 이벤트 중복·시간 역행·출처 불일치와 저장 상태 복원 조건을 검증</li>
            <li>연구 및 가상 실행 경로를 개발·검증 중이며 PAPER/LIVE 주문과 브로커 연결은 비활성</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Python · PostgreSQL · QuantConnect · pytest · GitHub Actions</p>
        </article>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">2026 — Present · Personal / Java Backend</p>
              <h2>StratDock-Observatory</h2>
              <p class="project-subtitle">Java/Spring 기반 읽기 전용 관제 앱과 응답 계약 검증</p>
            </div>
          </div>
          <ul class="career-highlights compact">
            <li>별도 읽기 전용 DB 연결, 응답 상태·필드 검증과 React 관제 UI 구성</li>
            <li>합성 데이터를 이용해 PostgreSQL → Spring API → 웹 화면의 연동 흐름 검증</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Java 25 · Spring Boot · JDBC · PostgreSQL · React · TypeScript</p>
        </article>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">2026.02 시작 · Legacy / Previous Operations</p>
              <h2>Stock-manager (이전 프로젝트)</h2>
              <p class="project-subtitle">StratDock 이전 투자 데이터 프로젝트의 클라우드 배포·장애 대응</p>
            </div>
            <a href={`${base}/cases/stock-manager-production/`}>Detailed case ↗</a>
          </div>
          <ul class="career-highlights compact">
            <li>Windows 기반 분석 프로토타입을 Docker·PostgreSQL 환경으로 재설계하고 AWS ECS/Fargate·ECR·RDS로 이전</li>
            <li>GitHub Actions 기반 CI/CD 구성, ECS Task 기동 장애를 Service Event와 컨테이너 로그로 추적해 수정</li>
            <li>AWS 콘솔 설정과 배포·장애 대응은 직접 수행하고, 오류 판별에 AI를 보조적으로 활용</li>
            <li>PostgreSQL 운영 중 deadlock과 lock timeout을 구분해 rollback, 제한 재시도, 안전한 실패 처리 적용</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Python · PostgreSQL · Docker · AWS ECS/Fargate · ECR · RDS · SSM · CloudWatch · GitHub Actions</p>
        </article>
      </section>

      <section class="resume-section" id="study">
        <div class="resume-section-head">
          <p class="section-label">학습 및 실습</p>
        </div>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">Java · Spring · JPA</p>
              <h2>백엔드 학습 기록</h2>
              <p class="project-subtitle">Java와 Spring의 주요 동작을 예제 코드와 테스트로 직접 정리했습니다.</p>
            </div>
            <a href="https://github.com/LIMJAELIN/backend-engineering-lab" target="_blank" rel="noreferrer">학습 저장소 보기 ↗</a>
          </div>
          <p class="lab-topic-line">Persistence Context · Dirty Checking · N+1 / Fetch Join · Optimistic Lock · REQUIRED / REQUIRES_NEW</p>
          <p class="stack-line"><strong>Stack</strong> Java 21 · Spring Boot · Spring Data JPA · Hibernate · PostgreSQL · GitHub Actions</p>
        </article>
      </section>

      <section class="resume-section">
        <div class="resume-section-head">
          <p class="section-label">OTHER EXPERIENCE</p>
        </div>
        <div class="other-experience-list">
          {moreExperience.map((item) => (
            <article>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section education-resume">
        <div class="resume-section-head"><p class="section-label">EDUCATION</p></div>
        <div class="education-row">
          <span>재학 중</span>
          <div>
            <h2>한국방송통신대학교</h2>
            <p>컴퓨터과학과 · 3학년 편입</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</SiteLayout>
