---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const skillGroups = [
  {
    title: '백엔드',
    items: ['Java', 'Spring Boot', 'Spring MVC', 'Spring Transaction', 'MyBatis', 'Spring Scheduler'],
  },
  {
    title: '데이터베이스·연동',
    items: ['Oracle', 'PostgreSQL', 'SQL', 'REST API', 'HikariCP'],
  },
  {
    title: '클라우드·배포',
    items: ['Docker', 'Docker Compose', 'AWS ECS/Fargate', 'ECR', 'RDS', 'SSM', 'CloudWatch', 'GitHub Actions'],
  },
  {
    title: '학습 및 개인 프로젝트',
    items: ['Java', 'Spring Boot', 'Spring Data JPA', 'Hibernate', 'JDBC', 'PostgreSQL'],
  },
];

const productionCases = [
  {
    index: '01',
    type: '초기 진입 개선',
    title: '사원등록 화면의 초기 진입 개선',
    summary: '10개가 넘는 하위 탭을 가진 화면에서 최초 진입에 필요하지 않은 초기화와 조회를 실제 사용 시점으로 지연해 초기 경로를 단순화했습니다.',
    evidence: ['지연 로딩', '화면–API 호출 흐름 분석', '실무 시스템'],
    href: `${base}/cases/employee-loading-performance/`,
  },
  {
    index: '02',
    featured: true,
    type: '근무 규칙',
    title: '복잡한 근무정책을 일자별 근무계획으로 변환',
    summary: '근무유형별 시간·교대 규칙과 여러 휴게시간 입력 경로를 하나의 생성 흐름에서 처리하고 자정 경계·비근무일 예외조건을 보완했습니다.',
    evidence: ['5개 근무유형', '3개 휴게시간 소스', '날짜 경계 / 정합성'],
    href: `${base}/cases/work-schedule-policy/`,
  },
  {
    index: '03',
    type: '배치 처리',
    title: '재집계 배치의 대상 선별과 부분 실패 격리',
    summary: '출퇴근 기록 등이 바뀌면 해당 날짜의 근태를 다시 계산하고, 한 건이 실패해도 나머지 처리가 계속되도록 구성했습니다.',
    evidence: ['REQUIRES_NEW', '부분 실패 격리', '재처리 / 실패 집계'],
    href: `${base}/cases/batch-partial-failure/`,
  },
  {
    index: '04',
    type: '데이터베이스 연결',
    title: 'Multi DataSource Routing',
    summary: '회사마다 다른 데이터베이스를 사용하는 환경에서 회사에 맞는 DB를 선택하고, 실제 연결 시점과 트랜잭션 순서까지 고려했습니다.',
    evidence: ['3 DataSources', 'LazyConnectionDataSourceProxy', 'HikariCP'],
    href: `${base}/cases/multi-datasource-routing/`,
  },
  {
    index: '05',
    featured: true,
    type: '마감·재집계',
    stage: '회사 업무',
    title: '월근태 마감 후 변경 감지와 선택 재집계',
    summary: '한 달의 근태를 확정한 뒤 출퇴근·휴가 등의 기록이 바뀌면 담당자가 확인하고 필요한 날짜만 다시 계산할 수 있도록 했습니다.',
    evidence: ['근태 기록 변경 확인', 'FOR UPDATE', '선택 날짜 재집계'],
    href: `${base}/cases/month-close-rebuild/`,
  },
  {
    index: '06',
    featured: true,
    type: '외부 연동',
    stage: '회사 업무',
    title: 'Windows 근태 수집 앱과 ERP 연동',
    summary: '출입 장비의 기록을 Windows 수집 프로그램에서 읽어 서버로 보내고, ERP에서 사용할 수 있도록 연결했습니다.',
    evidence: ['Electron / Node.js', 'PostgreSQL / SQLite', '시간대 / API 계약'],
    href: `${base}/cases/attendance-integration/`,
  },
];

const moreExperience = [
  {
    title: '근태 일정 화면 개선',
    description: '근태 일정 위젯을 구현하고 화면의 조회 조건부터 Spring Service 분기와 MyBatis 조회 SQL까지 한 흐름으로 수정했습니다.',
  },
  {
    title: '근태 알림 상태 관리',
    description: '미출근·미퇴근 알림의 대기·발송중·성공·실패 상태를 분리하고 실패 대상 재처리와 중복 생성을 방지했습니다.',
  },
  {
    title: '전자계약 연동',
    description: 'ERP에서 사원 정보를 전자계약 서비스로 보내 계약을 만들고, 계약 상태와 PDF를 조회할 수 있도록 연결했습니다.',
  },
];
---

<SiteLayout>
  <div class="resume-home">
    <section class="resume-intro resume-sheet" id="top">
      <div class="intro-grid"><div>
      <p class="resume-kicker">BACKEND DEVELOPER · 비즈비 ERP 개발 2팀</p>
      <h1>임재린</h1>
      <p class="intro-meta">2024.02 — 현재 · Java / Spring · Oracle</p>
      <p class="intro-lead">인사·근태 ERP를 개발합니다.</p>
      <p class="intro-body">근무계획, 근태 재집계, 외부 근태 장비와 전자계약 연동을 맡고 있습니다. 개인 프로젝트에서는 투자 데이터 수집과 AWS 배포·장애 대응을 경험했습니다.</p>
      <div class="intro-links">
        <a href="mailto:imjaelin@gmail.com">imjaelin@gmail.com</a>
        <a href="https://github.com/LIMJAELIN" target="_blank" rel="noreferrer">github.com/LIMJAELIN ↗</a>
      </div>
      </div><img class="intro-photo" src={`${base}/profile.png`} alt="임재린 프로필 사진" width="900" height="1200" /></div>
    </section>

    <div class="resume-document resume-sheet">
      <section class="resume-section" id="experience">
        <div class="resume-section-head">
          <p class="section-label">경력</p>
          <span>2024.02 — 현재</span>
        </div>
        <article class="career-block">
          <h2>비즈비 · ERP 개발 2팀</h2>
          <p class="career-intro">직원의 근무계획, 출퇴근 기록, 급여 등을 관리하는 인사 ERP를 개발하고 있습니다. 회사마다 다른 근무 규칙을 시스템에 반영하고, 외부 근태 장비와 전자계약 서비스를 연결하는 업무를 맡고 있습니다.</p>
        </article>
      </section>
      <section class="resume-section featured-work" aria-labelledby="featured-title">
        <h2 id="featured-title">주요 업무 사례</h2>
        <div class="featured-grid">
          <a href={`${base}/cases/work-schedule-policy/`}><span>근무정책</span><strong>{productionCases[1].title}</strong><p>근무유형별 계획을 만들면서 담당자가 조정한 내용을 배치에서 보호했습니다.</p><b>근무계획 사례 보기 ↗</b></a>
          <a href={`${base}/cases/month-close-rebuild/`}><span>마감과 재집계</span><strong>{productionCases[4].title}</strong><p>한 달의 근태를 확정한 뒤 기록이 바뀌면 필요한 날짜만 다시 계산할 수 있도록 했습니다.</p><b>월근태 사례 보기 ↗</b></a>
          <a href={`${base}/cases/attendance-integration/`}><span>외부 연동</span><strong>{productionCases[5].title}</strong><p>Windows 수집 앱의 조회·동기화·전송과 ERP 연동을 다뤘습니다.</p><b>근태 연동 사례 보기 ↗</b></a>
        </div>
      </section>
      <section class="resume-section" id="projects">
        <div class="resume-section-head">
          <p class="section-label">그 밖의 업무 사례</p>
        </div>

        <div class="project-list">
          {productionCases.filter((item) => !item.featured).map((item) => (
            <a class="project-row" href={item.href}>
              <div class="project-content">
                <div class="project-eyebrow">{item.type} · {item.stage || '회사 업무'}</div>
                <h2>{item.title}</h2>
                <p>{item.summary}</p>
                <div class="project-tags">{item.evidence.map((tag) => <span>{tag}</span>)}</div>
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="resume-section" id="personal-projects">
        <div class="resume-section-head">
          <p class="section-label">개인 프로젝트</p>
        </div>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">2026 — 현재 · 개인 프로젝트</p>
              <h2>StratDock</h2>
              <p class="project-subtitle">투자 방법을 연구하고 과거 데이터와 가상 매매로 검토하는 개인 프로젝트</p>
            </div>
          </div>
          <ul class="career-highlights compact">
            <li>투자 판단에 사용하는 자료의 형식과 출처를 확인하고, 같은 기록의 중복 처리나 시간 순서 오류를 막는 기능 개발</li>
            <li>실제 돈을 쓰지 않는 가상 매매 기록을 저장하고 중단 후 다시 불러오는 흐름을 개발·검증 중</li>
            <li>실제 투자 없이 과거 자료와 가상 매매로 투자 방법을 검토</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Python · PostgreSQL · QuantConnect · pytest · GitHub Actions</p>
        </article>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">2026 — 현재 · 개인 프로젝트</p>
              <h2>StratDock-Observatory</h2>
              <p class="project-subtitle">투자 연구 시스템의 실행 기록을 한눈에 살펴보는 별도 웹 애플리케이션</p>
            </div>
          </div>
          <ul class="career-highlights compact">
            <li>연구 시스템의 원본을 바꾸지 않고 기록을 확인할 수 있도록 읽기 전용 DB 연결과 화면 개발</li>
            <li>실행 기록과 실제 프로그램 실행 여부를 구분하고, 테스트용 데이터로 DB부터 화면까지 연동 확인</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Java · Spring Boot · JDBC · PostgreSQL · React · TypeScript</p>
        </article>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">2026.02 시작 · 이전 개인 프로젝트</p>
              <h2>Stock-manager (이전 프로젝트)</h2>
              <p class="project-subtitle">StratDock 이전 투자 데이터 프로젝트의 클라우드 배포·장애 대응</p>
            </div>
            <a href={`${base}/cases/stock-manager-production/`}>배포 사례 보기 ↗</a>
          </div>
          <ul class="career-highlights compact">
            <li>Windows 기반 분석 프로토타입을 Docker·PostgreSQL 환경으로 재설계하고 AWS ECS/Fargate·ECR·RDS로 이전</li>
            <li>GitHub Actions 기반 CI/CD 구성, ECS Task 기동 장애를 Service Event와 컨테이너 로그로 추적해 수정</li>
            <li>AWS 콘솔 설정과 배포·장애 대응은 직접 수행하고, 오류 판별에 AI를 보조적으로 활용</li>
            <li>금융 API 수집에서 호출 제한·시장 시간을 고려하고 비동기 처리 적용</li>
            <li>PostgreSQL 운영 중 deadlock과 lock timeout을 구분해 rollback, 제한 재시도, 안전한 실패 처리 적용</li>
          </ul>
          <p class="stack-line"><strong>Stack</strong> Python · PostgreSQL · Docker · AWS ECS/Fargate · ECR · RDS · SSM · CloudWatch · GitHub Actions</p>
        </article>
      </section>

      <section class="resume-section" id="skills">
        <div class="resume-section-head">
          <p class="section-label">기술 스택</p>
        </div>
        <div class="skill-matrix">
          {skillGroups.map((group) => (
            <div class="skill-row">
              <div class="skill-title">
                <h2>{group.title}</h2>
              </div>
              <p class="skill-items">{group.items.join(' · ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="resume-section" id="study">
        <div class="resume-section-head">
          <p class="section-label">학습</p>
        </div>

        <article class="flat-project">
          <div class="flat-project-head">
            <div>
              <p class="project-eyebrow">Java · Spring · JPA</p>
              <h2>백엔드 학습 기록</h2>
              <p class="project-subtitle">Java와 Spring의 주요 동작을 예제 코드와 테스트로 직접 정리했습니다.</p>
            </div>
            <a href="https://github.com/LIMJAELIN/backend-engineering-lab" target="_blank" rel="noreferrer">GitHub에서 보기 ↗</a>
          </div>
          <p class="lab-topic-line">Persistence Context · Dirty Checking · N+1 / Fetch Join · Optimistic Lock · REQUIRED / REQUIRES_NEW</p>
          <p class="stack-line"><strong>Stack</strong> Java · Spring Boot · Spring Data JPA · Hibernate · PostgreSQL · GitHub Actions</p>
        </article>
      </section>

      <section class="resume-section">
        <div class="resume-section-head">
          <p class="section-label">그 밖의 업무 경험</p>
        </div>
        <div class="other-experience-list">
          {moreExperience.map((item) => (
            <article>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section education-resume">
        <div class="resume-section-head"><p class="section-label">학력</p></div>
        <div class="education-row">
          <span>재학 중</span>
          <div>
            <h2>한국방송통신대학교</h2>
            <p>컴퓨터과학과 · 3학년 편입</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</SiteLayout>
